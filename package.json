{
  "name": "aman-thakur-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "scrape:instagram": "bun run scripts/scrape-instagram.ts",
    "scrape:instagram:refresh": "bun run scripts/scrape-instagram.ts --limit=12",
    "prebuild": "bun run scripts/scrape-instagram.ts || true",
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "dev:all": "bun run chatbot:dev & bun run dev",
    "chatbot:dev": "bun run scripts/chatbot-server.ts",
    "chatbot:start": "bun run scripts/chatbot-server.ts"
  },
  "dependencies": {
    "@hey-amanthakur/chat-bot": "^1.0.2",
    "@hookform/resolvers": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.3.0",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "description": "A modern, animated personal portfolio website built with **React 19**, **TypeScript**, **Vite**, and **TailwindCSS**. Features dark/light theme, scroll-driven animations, and a build-time Instagram scraper that pulls live posts from [@yeh.safar.swaad.ka](https://www.instagram.com/yeh.safar.swaad.ka/).",
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonsnow456/portfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jhonsnow456/portfolio/issues"
  },
  "homepage": "https://github.com/jhonsnow456/portfolio#readme"
}
